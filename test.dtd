<!ENTITY kospi "한국거래소 유가증권시장">
<!ENTITY kosdaq "한국거래소 코스닥시장">
<!ENTITY nasdaq "미국 나스닥 증권거래소">
<!ENTITY nyse "미국 뉴욕증권거래소">
<!ENTITY % ID " id CDATA #REQUIRED">

<!ELEMENT stockManagement (companies, markets, sectors, transactions, accounts)>
<!ELEMENT companies (company*)>
<!ELEMENT company (name, ticker, financialReports)>
<!ATTLIST company %ID;
                    market (KOSPI | KOSDAQ | NASDAQ | NYSE) #REQUIRED
                    sector CDATA #REQUIRED>
<!ELEMENT financialReports (financialReport*)>
<!ATTLIST financialReports currency (USD | KRW) #REQUIRED
                            unit (trillion | billion) #IMPLIED>
<!ELEMENT financialReport (revenue, operatingIncome, netIncome)>
<!ATTLIST financialReport year CDATA #REQUIRED>
<!ATTLIST financialReport quarter (Q1 | Q2 | Q3 | Q4) #REQUIRED>
<!ATTLIST financialReport status (released | unreleased) "released">

<!ELEMENT markets (market*)>
<!ELEMENT market (name, description)>
<!ATTLIST market %ID;>

<!ELEMENT sectors (sector*)>
<!ELEMENT sector (name, stocks)>
<!ATTLIST sector %ID;>
<!ATTLIST stock %ID;>
<!ELEMENT stocks (stock*)>
<!ELEMENT stock EMPTY>

<!ELEMENT transactions (transaction*)>
<!ELEMENT transaction (accountID+, companyID+, date+, type+, quantity+, price+)>
<!ATTLIST transaction %ID;>

<!ELEMENT accounts (account*)>
<!ATTLIST account %ID;>
<!ELEMENT account (userID, balance+, transactionHistory*)>
<!ATTLIST balance currency  (USD | KRW) #REQUIRED>
<!ELEMENT transactionHistory (transactionID*)>

<!ELEMENT revenue (#PCDATA)>
<!ELEMENT operatingIncome (#PCDATA)>
<!ELEMENT netIncome (#PCDATA)>
<!ELEMENT ticker (#PCDATA)>
<!ELEMENT description (#PCDATA) >
<!ELEMENT companyID (#PCDATA)>
<!ELEMENT date (#PCDATA)>
<!ELEMENT type (#PCDATA)>
<!ELEMENT quantity (#PCDATA)>
<!ELEMENT price (#PCDATA)>
<!ELEMENT name (#PCDATA)>
<!ELEMENT accountID (#PCDATA)>
<!ELEMENT balance (#PCDATA)>
<!ELEMENT transactionID (#PCDATA)>
<!ELEMENT userID (#PCDATA)>